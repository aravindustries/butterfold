# Copy this file to .env and fill in what you need. Every value below is
# optional — with nothing set, the whole pipeline (agents/orchestrator.py)
# runs end-to-end with NO LLM at all, using each agent's deterministic
# fallback. See agents/llm_provider.py for the full explanation.

# --- proprietary provider (optional) -------------------------------------
OPENAI_API_KEY=

# --- provider selection ----------------------------------------------------
# openai | openweight | none | auto  (auto: picks openweight if a base url is
# set, else openai if a key is set, else none)
BUTTERFOLD_LLM_PROVIDER=auto

# --- open-weight model, served behind ANY OpenAI-compatible endpoint ------
# Ollama example:
#   BUTTERFOLD_LLM_BASE_URL=http://localhost:11434/v1
#   BUTTERFOLD_LLM_MODEL=qwen2.5-coder:32b
# vLLM example:
#   BUTTERFOLD_LLM_BASE_URL=http://localhost:8000/v1
#   BUTTERFOLD_LLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
BUTTERFOLD_LLM_BASE_URL=
BUTTERFOLD_LLM_MODEL=
BUTTERFOLD_LLM_API_KEY=not-needed

BUTTERFOLD_LLM_TEMPERATURE=0

# --- pipeline stage gates ---------------------------------------------------
# 1 = let the ReAct code agent (re)write generated/rtl/*.v
BUTTERFOLD_AUTHOR_RTL=

# 1 = run the full LibreLane RTL->GDS flow (needs the EDA container)
BUTTERFOLD_GDS=
