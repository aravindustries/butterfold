start_gui
source /home/eloquencer/Projects/butterfold/frontend/proj/scripts/init.tcl -notrace
update_compile_order -fileset sources_1
source ../../scripts/orchestrate_proj.tcl
update_compile_order -fileset sources_1
launch_simulation
source counter.tcl
add_force {/counter/clk} -radix hex {0 0ns} {1 50000ps} -repeat_every 100000ps
add_force {/counter/rst} -radix hex {0 0ns}
run 1 us
add_force {/counter/rst} -radix hex {1 0ns}
run 1 us
add_force {/counter/rst} -radix hex {0 0ns}
run 1 us
update_compile_order -fileset sources_1
update_compile_order -fileset sources_1
close_sim
