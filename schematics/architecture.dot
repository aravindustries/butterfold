digraph butterfold {
  rankdir=LR;
  graph [fontname="Helvetica", labelloc=t, fontsize=16,
         label="ButterFold — modular DFT-s-OFDM chip (6 modules from butterfold_module_io.md)"];
  node  [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#eef4ff"];
  edge  [fontname="Helvetica", fontsize=10];

  din  [label="din[7:0]\ndin_valid_i / din_ready_o", shape=cds, fillcolor="#fff2cc"];
  dout [label="dout[7:0]\ndout_valid_o / dout_ready_i", shape=cds, fillcolor="#fff2cc"];
  irq  [label="done_irq_o", shape=cds, fillcolor="#fff2cc"];

  // control
  sch  [label="scheduler_addr_control\n(control brain: sequences DFT-12 /\nFFT-128 / IFFT-128, gen addrs,\nmap+CP+twiddle control)", fillcolor="#dae3f3"];

  // datapath core + shared resources
  subgraph cluster_core {
    label="unified_mixed_radix_core"; style="rounded,dashed"; color="#548235"; fontname="Helvetica";
    mem  [label="scratch memory\n128 x 16b complex\n(register file OR 4x SRAM)", fillcolor="#e2f0d9"];
    alu  [label="shared complex multiplier\n+ radix-2 butterfly\n+ scale / round / saturate", fillcolor="#e2f0d9"];
  }
  tw   [label="twiddle_source\n(Q1.7 twiddle ROM,\nconjugate for inverse)", fillcolor="#e2f0d9"];

  // frequency-domain side
  fdiq [label="fdiq_io_adapter\n(freq-domain I/Q byte pack/unpack,\n12 QAM samples)"];
  map  [label="subcarrier_map_extract\n(centered map / extract,\nbins 58..69 of 128)"];

  // time-domain side
  tdiq [label="tdiq_io_adapter_cp\n(time-domain I/Q byte pack/unpack,\nCP insert/remove 9|10)"];

  // command + streaming
  din  -> sch  [label="cmd byte (0x03 TX / 0x04 RX)"];
  din  -> fdiq [label="TX freq I/Q", color="#2e75b6"];
  din  -> tdiq [label="RX time I/Q", color="#c55a11"];

  // control fan-out
  sch  -> alu  [label="uop / addrs"];
  sch  -> tw   [label="tw_req/addr"];
  sch  -> map  [label="map ctrl"];
  sch  -> tdiq [label="CP ctrl"];

  // datapath connectivity
  fdiq -> mem  [label="load", color="#2e75b6"];
  tdiq -> mem  [label="load (RX)", color="#c55a11"];
  tw   -> alu  [style=dotted, dir=none, color="#548235"];
  mem  -> alu  [dir=both, color="#548235"];
  mem  -> map  [label="read"];
  map  -> fdiq [label="extract -> dout (RX)", color="#c55a11"];
  mem  -> tdiq [label="read -> dout (TX)", color="#2e75b6"];

  fdiq -> dout;
  tdiq -> dout;
  sch  -> irq  [label="done"];
}
