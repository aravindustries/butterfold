layout {
    pane_template name="bar" {
        borderless true
        plugin location="zellij:compact-bar";
    }
    new_tab_template {
        pane
        bar size=1
    }

    cwd "$PROJECT_ROOT_DIR"

    tab name="Git" hide_floating_panes=true {
        pane split_direction="horizontal" {
            pane size="70%" name="lazygit" {
                command "lazygit"
            }
            pane size="30%" focus=true name="review git" {
                command "$EDITOR"
                args ".gitignore" ".gitmodules"
            }
        }
        floating_panes {
            pane name="btop" width="65%" height="65%" start_suspended=true {
                command "btop"
            }
        }
        bar size=1
    }
    tab name="Docs" cwd="docs" {
        pane split_direction="horizontal" {
            pane focus=true size="70%" name="code" size="70%" {
                command "$SHELL"
                args "-ci" "y"
            }
            pane size="30%" name="execute"
        }
        bar size=1
    }
    tab name="AI" {
        pane name="hermes" {
            command "hermes"
            // args "chat" "--query-file" "agents/orchestrator.md"
        }
        bar size=1
    }
    tab focus=true name="Dev" {
        pane size="70%" stacked=true split_direction="horizontal" {
            pane expanded=true name="design" cwd="$RTL_DIR" {
                command "$SHELL"
                args "-ci" "y"
            }
            pane name="verif" cwd="$SIM_DIR" {
                command "$SHELL"
                args "-ci" "y"
            }
        }
        pane focus=true size="30%" name="execute" {
            command "$SHELL"
            args "-c" "sleep 0.1; fastfetch; mise tasks ls; exec $SHELL"
        }
        bar size=1
    }
}

