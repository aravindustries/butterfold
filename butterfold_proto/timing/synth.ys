read_verilog -sv -D GF180_USE_FOUNDRY_SRAM \
    timing/sram_blackboxes.sv \
    gf180_sram_256x8_wrapper.sv \
    gf180_sram_256x16_complex.sv \
    fft128_modulo_controller.sv \
    fft128_twiddle_rom.sv \
    mixed_radix_butterfly.sv \
    tdiq_input_cp_remove.sv \
    fdiq_input_adapter.sv \
    fdiq_output_adapter_sram.sv \
    tdiq_output_cp_insert_sram.sv \
    subcarrier_mapper.sv \
    subcarrier_extractor.sv \
    standalone_result_serializer.sv \
    transform_scheduler_core.sv \
    butterfold_top.sv

hierarchy -check -top butterfold_top
synth -top butterfold_top -flatten -noabc
techmap -map timing/latch_map.v
dfflibmap \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffnq_1 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffnq_4 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffnrnq_1 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffnrnq_4 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffnsnq_1 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffnsnq_4 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffq_1 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffq_4 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffrnq_1 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffrnq_4 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffsnq_1 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffsnq_4 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffnrsnq_1 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffnrsnq_4 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffrsnq_1 \
    -dont_use gf180mcu_fd_sc_mcu9t5v0__dffrsnq_4 \
    -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/lib/gf180mcu_fd_sc_mcu9t5v0__ss_125C_4v50.lib
abc -D 10000 \
    -constr timing/abc.constr \
    -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/lib/gf180mcu_fd_sc_mcu9t5v0__ss_125C_4v50.lib
clean -purge

check
select -assert-none t:$mul t:$add t:$sub t:$macc t:$mux t:$dff t:$dlatch t:$lut
stat -liberty /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/lib/gf180mcu_fd_sc_mcu9t5v0__ss_125C_4v50.lib
write_verilog -noattr timing/results/butterfold_mapped.v
write_json timing/results/butterfold_mapped.json
