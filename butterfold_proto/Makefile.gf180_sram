PYTHON ?= python3
IVERILOG ?= iverilog
VVP ?= vvp
SIM_BUILD := build/sim
TB_DIR := verification/tb

# Use the installed GF180MCU SRAM library by default.
PDKPATH ?= /foss/pdks/gf180mcuD
SRAM_VERILOG_DIR ?= $(PDKPATH)/libs.ref/gf180mcu_fd_ip_sram/verilog
SRAM256_MODEL ?= $(SRAM_VERILOG_DIR)/gf180mcu_fd_ip_sram__sram256x8m8wm1.v

COMMON_RTL = \
	rtl/memory/gf180_sram_256x8_wrapper.sv \
	rtl/memory/gf180_sram_256x16_complex.sv \
	rtl/transform/fft128_modulo_controller.sv \
	rtl/transform/fft128_twiddle_rom.sv \
	rtl/transform/mixed_radix_butterfly.sv \
	rtl/io/tdiq_input_cp_remove.sv \
	rtl/io/fdiq_input_adapter.sv \
	rtl/io/fdiq_output_adapter_sram.sv \
	rtl/io/tdiq_output_cp_insert_sram.sv \
	rtl/io/subcarrier_mapper.sv \
	rtl/io/subcarrier_extractor.sv \
	rtl/io/standalone_result_serializer.sv \
	rtl/scheduler/transform_scheduler_core.sv \
	rtl/top/butterfold_top.sv

.PHONY: vectors wrapper reset-recovery behavioral foundry foundry-functional foundry-info \
	characterize stress-fast stress-paced scheduled-fast scheduled-paced padframe-smoke synth-sta clean

vectors:
	$(PYTHON) gen_realtime_vectors.py

wrapper:
	mkdir -p $(SIM_BUILD)
	$(IVERILOG) -g2012 -Wall -s gf180_sram_wrapper_tb -o $(SIM_BUILD)/sim_sram_wrapper.out \
		$(TB_DIR)/gf180_sram_wrapper_tb.sv rtl/memory/gf180_sram_256x8_wrapper.sv \
		rtl/memory/gf180_sram_256x16_complex.sv
	$(VVP) $(SIM_BUILD)/sim_sram_wrapper.out

reset-recovery:
	mkdir -p $(SIM_BUILD)
	$(IVERILOG) -g2012 -Wall -s reset_recovery_tb -o $(SIM_BUILD)/sim_reset_recovery.out \
		$(TB_DIR)/reset_recovery_tb.sv $(COMMON_RTL)
	$(VVP) $(SIM_BUILD)/sim_reset_recovery.out

padframe-smoke:
	mkdir -p $(SIM_BUILD)
	$(IVERILOG) -g2012 -Wall -Dfunctional -s butterfold_padframe_tb \
		-o $(SIM_BUILD)/sim_padframe_smoke.out $(TB_DIR)/butterfold_padframe_tb.sv \
		rtl/padframe/butterfold_padframe_top.sv $(COMMON_RTL) \
		$(PDKPATH)/libs.ref/gf180mcu_fd_io/verilog/gf180mcu_fd_io.v \
		$(PDKPATH)/libs.ref/gf180mcu_fd_sc_mcu9t5v0/verilog/primitives.v \
		$(PDKPATH)/libs.ref/gf180mcu_fd_sc_mcu9t5v0/verilog/gf180mcu_fd_sc_mcu9t5v0.v
	$(VVP) $(SIM_BUILD)/sim_padframe_smoke.out

behavioral: vectors
	mkdir -p $(SIM_BUILD)
	$(IVERILOG) -g2012 -Wall -s butterfold_top_tb -o $(SIM_BUILD)/sim_butterfold_sram.out \
		$(TB_DIR)/butterfold_top_tb.sv $(COMMON_RTL)
	$(VVP) $(SIM_BUILD)/sim_butterfold_sram.out

characterize: vectors
	mkdir -p $(SIM_BUILD)
	$(IVERILOG) -g2012 -Wall -DBUTTERFOLD_PERF -s butterfold_top_tb \
		-o $(SIM_BUILD)/sim_butterfold_characterize.out $(TB_DIR)/butterfold_top_tb.sv $(COMMON_RTL)
	$(VVP) $(SIM_BUILD)/sim_butterfold_characterize.out

stress-fast: vectors
	mkdir -p $(SIM_BUILD)
	$(IVERILOG) -g2012 -Wall -DBUTTERFOLD_STRESS -s butterfold_top_tb \
		-o $(SIM_BUILD)/sim_butterfold_stress_fast.out $(TB_DIR)/butterfold_top_tb.sv $(COMMON_RTL)
	$(VVP) $(SIM_BUILD)/sim_butterfold_stress_fast.out

# At 61.44 MHz, 16 core clocks per output byte gives 3.84 Mbyte/s,
# corresponding to 1.92 Msamples/s for interleaved complex waveform bytes.
stress-paced: vectors
	mkdir -p $(SIM_BUILD)
	$(IVERILOG) -g2012 -Wall -DBUTTERFOLD_STRESS \
		-DBUTTERFOLD_WAVE_PACED -s butterfold_top_tb \
		-o $(SIM_BUILD)/sim_butterfold_stress_paced.out $(TB_DIR)/butterfold_top_tb.sv $(COMMON_RTL)
	$(VVP) $(SIM_BUILD)/sim_butterfold_stress_paced.out

scheduled-fast: vectors
	mkdir -p $(SIM_BUILD)
	$(IVERILOG) -g2012 -Wall -DBUTTERFOLD_SCHEDULED -s butterfold_top_tb \
		-o $(SIM_BUILD)/sim_butterfold_scheduled_fast.out $(TB_DIR)/butterfold_top_tb.sv $(COMMON_RTL)
	$(VVP) $(SIM_BUILD)/sim_butterfold_scheduled_fast.out

scheduled-paced: vectors
	mkdir -p $(SIM_BUILD)
	$(IVERILOG) -g2012 -Wall -DBUTTERFOLD_SCHEDULED \
		-DBUTTERFOLD_WAVE_PACED -s butterfold_top_tb \
		-o $(SIM_BUILD)/sim_butterfold_scheduled_paced.out $(TB_DIR)/butterfold_top_tb.sv $(COMMON_RTL)
	$(VVP) $(SIM_BUILD)/sim_butterfold_scheduled_paced.out

# Official GlobalFoundries SRAM Verilog models, FUNCTIONAL mode.
# IMPORTANT: intentionally DO NOT pass -gspecify to Icarus.
# The GF SRAM models contain bit-select specify path declarations that Icarus
# cannot elaborate. Functional SRAM behavior is still taken directly from the
# official foundry model; final SRAM timing is checked from the GF Liberty files
# during STA rather than with Icarus specify timing.
foundry: foundry-functional

foundry-functional: vectors
	mkdir -p $(SIM_BUILD)
	@test -f "$(SRAM256_MODEL)" || (echo "Missing SRAM256 model: $(SRAM256_MODEL)"; exit 1)
	$(IVERILOG) -g2012 -Wall -DGF180_USE_FOUNDRY_SRAM \
		-s butterfold_top_tb -o $(SIM_BUILD)/sim_butterfold_foundry_sram.out \
		$(TB_DIR)/butterfold_top_tb.sv $(COMMON_RTL) $(SRAM256_MODEL)
	$(VVP) $(SIM_BUILD)/sim_butterfold_foundry_sram.out

foundry-info:
	@echo "PDKPATH          = $(PDKPATH)"
	@echo "SRAM256_MODEL    = $(SRAM256_MODEL)"
	@echo ""
	@echo "Icarus is used only for functional foundry-model simulation."
	@echo "Do not enable -gspecify for these GF SRAM models under Icarus."
	@echo "Use the SRAM Liberty views under:"
	@echo "  $(PDKPATH)/libs.ref/gf180mcu_fd_ip_sram/lib"
	@echo "for final timing/STA."

synth-sta:
	mkdir -p timing/results
	yosys -l timing/results/yosys.log -s timing/synth.ys
	sta -no_init -exit timing/sta.tcl | tee timing/results/sta_summary.log

clean:
	rm -f $(SIM_BUILD)/*.out *.vcd
