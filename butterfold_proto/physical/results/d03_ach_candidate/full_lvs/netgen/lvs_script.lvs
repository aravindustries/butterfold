# Full device-level Netgen LVS for hold26 Magic GDS.
# LAYOUT: Magic GDS extraction, SRAM LEFview abstract.
# SOURCE: ECO powered Verilog + official CELL_SPICE_MODELS.
# SRAM transistor spice is intentionally NOT read.
set circuit1 [readnet spice /headless/aravindustries-repos/butterfold/butterfold_proto/physical/results/d03_ach_candidate/full_lvs/extract/butterfold_top.spice]
set circuit2 [readnet verilog /dev/null]
puts "Reading SPICE netlist file '/foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/spice/gf180mcu_fd_sc_mcu9t5v0.spice'..."
readnet spice /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/spice/gf180mcu_fd_sc_mcu9t5v0.spice $circuit2
puts "Reading Verilog netlist file '/headless/aravindustries-repos/butterfold/butterfold_proto/physical/results/d03_ach_candidate/butterfold_top.final.pnl.v'..."
readnet verilog /headless/aravindustries-repos/butterfold/butterfold_proto/physical/results/d03_ach_candidate/butterfold_top.final.pnl.v $circuit2
lvs "$circuit1 butterfold_top" "$circuit2 butterfold_top" /foss/pdks/gf180mcuD/libs.tech/netgen/gf180mcuD_setup.tcl /headless/aravindustries-repos/butterfold/butterfold_proto/physical/results/d03_ach_candidate/full_lvs/netgen/lvs.netgen.rpt -blackbox -json
