# Full device-level Netgen LVS for the CO.6a-repaired Magic GDS.
# LAYOUT: Magic GDS extraction, MAGIC_EXT_USE_GDS=1, SRAM LEFview abstract.
# SOURCE: filled powered Verilog + official CELL_SPICE_MODELS.
# Setup: official gf180mcuD_setup.tcl. -blackbox for empty SRAM/fill only.

set circuit1 [readnet spice /headless/aravindustries-repos/butterfold/butterfold_proto/physical/results/nw_pins_eco/co6a_repair/full_lvs/extract/butterfold_top.spice]
set circuit2 [readnet verilog /dev/null]
puts "Reading SPICE netlist file '/foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/spice/gf180mcu_fd_sc_mcu9t5v0.spice'..."
readnet spice /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/spice/gf180mcu_fd_sc_mcu9t5v0.spice $circuit2
puts "Reading Verilog netlist file filled pnl..."
readnet verilog /headless/aravindustries-repos/butterfold/butterfold_proto/physical/results/nw_pins_eco/co6a_repair/butterfold_top.filled.pnl.v $circuit2
lvs "$circuit1 butterfold_top" "$circuit2 butterfold_top" /foss/pdks/gf180mcuD/libs.tech/netgen/gf180mcuD_setup.tcl /headless/aravindustries-repos/butterfold/butterfold_proto/physical/results/nw_pins_eco/co6a_repair/full_lvs/netgen/lvs.netgen.rpt -blackbox -json
