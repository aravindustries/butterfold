# Full device-level Netgen LVS.
# LAYOUT: Magic GDS extraction of pre-fill team GDS (SHA 5a99213a...), SRAM LEFview abstract.
# SOURCE: ECO powered Verilog + official CELL_SPICE_MODELS (real nfet_05v0/pfet_05v0).
# SRAM transistor spice is intentionally NOT read (official hard-macro blackbox).
# Setup: official OpenPDKs gf180mcuD_setup.tcl.
# -blackbox: empty SRAM / ignored fill cells; stdcells have devices and are compared.

set circuit1 [readnet spice /headless/aravindustries-repos/butterfold/butterfold_proto/physical/results/final_signoff/full_lvs/extract/butterfold_top.spice]
set circuit2 [readnet verilog /dev/null]
puts "Reading SPICE netlist file '/foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/spice/gf180mcu_fd_sc_mcu9t5v0.spice'..."
readnet spice /foss/pdks/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/spice/gf180mcu_fd_sc_mcu9t5v0.spice $circuit2
puts "Reading Verilog netlist file '/headless/aravindustries-repos/butterfold/butterfold_proto/physical/results/final_signoff/butterfold_top.final.pnl.v'..."
readnet verilog /headless/aravindustries-repos/butterfold/butterfold_proto/physical/results/final_signoff/butterfold_top.final.pnl.v $circuit2
lvs "$circuit1 butterfold_top" "$circuit2 butterfold_top" /foss/pdks/gf180mcuD/libs.tech/netgen/gf180mcuD_setup.tcl /headless/aravindustries-repos/butterfold/butterfold_proto/physical/results/final_signoff/full_lvs/netgen/lvs.netgen.rpt -blackbox -json
