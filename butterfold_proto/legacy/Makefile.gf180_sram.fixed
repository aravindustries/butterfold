PYTHON ?= python3
IVERILOG ?= iverilog
VVP ?= vvp

# Use the installed GF180MCU SRAM library by default.
PDKPATH ?= /foss/pdks/gf180mcuD
SRAM_VERILOG_DIR ?= $(PDKPATH)/libs.ref/gf180mcu_fd_ip_sram/verilog
SRAM128_MODEL ?= $(SRAM_VERILOG_DIR)/gf180mcu_fd_ip_sram__sram128x8m8wm1.v
SRAM512_MODEL ?= $(SRAM_VERILOG_DIR)/gf180mcu_fd_ip_sram__sram512x8m8wm1.v

COMMON_RTL = \
	gf180_sram_128x8_wrapper.sv \
	gf180_sram_512x8_wrapper.sv \
	gf180_sram_128x32_complex.sv \
	fft128_twiddle_rom.sv \
	mixed_radix_butterfly.sv \
	tdiq_input_cp_remove.sv \
	fdiq_input_adapter.sv \
	fdiq_output_adapter_sram.sv \
	tdiq_output_cp_insert_sram.sv \
	subcarrier_mapper.sv \
	subcarrier_extractor.sv \
	standalone_result_serializer.sv \
	transform_scheduler_core.sv \
	butterfold_top.sv

.PHONY: vectors wrapper behavioral foundry foundry-functional foundry-info clean

vectors:
	$(PYTHON) gen_realtime_vectors.py

wrapper:
	$(IVERILOG) -g2012 -Wall -s gf180_sram_wrapper_tb -o sim_sram_wrapper.out \
		gf180_sram_wrapper_tb.sv gf180_sram_128x8_wrapper.sv \
		gf180_sram_512x8_wrapper.sv gf180_sram_128x32_complex.sv
	$(VVP) sim_sram_wrapper.out

behavioral: vectors
	$(IVERILOG) -g2012 -Wall -s butterfold_top_tb -o sim_butterfold_sram.out \
		butterfold_top_tb.sv $(COMMON_RTL)
	$(VVP) sim_butterfold_sram.out

# Official GlobalFoundries SRAM Verilog models, FUNCTIONAL mode.
# IMPORTANT: intentionally DO NOT pass -gspecify to Icarus.
# The GF SRAM models contain bit-select specify path declarations that Icarus
# cannot elaborate. Functional SRAM behavior is still taken directly from the
# official foundry model; final SRAM timing is checked from the GF Liberty files
# during STA rather than with Icarus specify timing.
foundry: foundry-functional

foundry-functional: vectors
	@test -f "$(SRAM128_MODEL)" || (echo "Missing SRAM128 model: $(SRAM128_MODEL)"; exit 1)
	@test -f "$(SRAM512_MODEL)" || (echo "Missing SRAM512 model: $(SRAM512_MODEL)"; exit 1)
	$(IVERILOG) -g2012 -Wall -DGF180_USE_FOUNDRY_SRAM \
		-s butterfold_top_tb -o sim_butterfold_foundry_sram.out \
		butterfold_top_tb.sv $(COMMON_RTL) $(SRAM128_MODEL) $(SRAM512_MODEL)
	$(VVP) sim_butterfold_foundry_sram.out

foundry-info:
	@echo "PDKPATH          = $(PDKPATH)"
	@echo "SRAM128_MODEL    = $(SRAM128_MODEL)"
	@echo "SRAM512_MODEL    = $(SRAM512_MODEL)"
	@echo ""
	@echo "Icarus is used only for functional foundry-model simulation."
	@echo "Do not enable -gspecify for these GF SRAM models under Icarus."
	@echo "Use the SRAM Liberty views under:"
	@echo "  $(PDKPATH)/libs.ref/gf180mcu_fd_ip_sram/lib"
	@echo "for final timing/STA."

clean:
	rm -f sim_sram_wrapper.out sim_butterfold_sram.out sim_butterfold_foundry_sram.out *.vcd
